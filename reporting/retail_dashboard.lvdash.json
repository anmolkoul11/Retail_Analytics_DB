{
  "datasets": [
    {
      "name": "daily",
      "displayName": "Daily sales",
      "queryLines": [
        "SELECT * FROM retail_demo.gold.daily_revenue"
      ]
    },
    {
      "name": "categories",
      "displayName": "Category sales",
      "queryLines": [
        "SELECT * FROM retail_demo.gold.category_revenue"
      ]
    },
    {
      "name": "regions",
      "displayName": "Regional sales",
      "queryLines": [
        "SELECT * FROM retail_demo.gold.regional_revenue"
      ]
    },
    {
      "name": "products",
      "displayName": "Product sales",
      "queryLines": [
        "SELECT product_id, product_name, category, revenue, units FROM retail_demo.gold.product_metrics ORDER BY revenue DESC, product_id LIMIT 10"
      ]
    }
  ],
  "pages": [
    {
      "name": "sales_pulse",
      "displayName": "Sales Pulse",
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1",
      "layout": [
        {
          "widget": {
            "name": "intro",
            "multilineTextboxSpec": {
              "lines": [
                "# Retail Orders | Sales Pulse\n",
                "Databricks Marketplace | Fictional retail records | Real Delta Sharing | USD\n",
                "Cancelled and returned lines excluded. Shipping, tax and refund accounting are not modeled.\n"
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "revenue",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "daily",
                  "fields": [
                    {
                      "name": "value",
                      "expression": "SUM(`revenue`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "value"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Completed-sales revenue (USD)"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 3,
            "width": 4,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "orders",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "daily",
                  "fields": [
                    {
                      "name": "value",
                      "expression": "SUM(`order_count`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "value"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Completed orders"
              }
            }
          },
          "position": {
            "x": 4,
            "y": 3,
            "width": 4,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "aov",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "daily",
                  "fields": [
                    {
                      "name": "value",
                      "expression": "SUM(`revenue`)/NULLIF(SUM(`order_count`),0)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "value"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Average order value (USD)"
              }
            }
          },
          "position": {
            "x": 8,
            "y": 3,
            "width": 4,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "trend",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "daily",
                  "fields": [
                    {
                      "name": "order_date",
                      "expression": "`order_date`"
                    },
                    {
                      "name": "revenue",
                      "expression": "SUM(`revenue`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "line",
              "frame": {
                "showTitle": true,
                "title": "Daily completed-sales revenue"
              },
              "encodings": {
                "x": {
                  "fieldName": "order_date",
                  "scale": {
                    "type": "temporal"
                  }
                },
                "y": {
                  "fieldName": "revenue",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "Revenue (USD)"
                }
              }
            }
          },
          "position": {
            "x": 0,
            "y": 6,
            "width": 12,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "category",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "categories",
                  "fields": [
                    {
                      "name": "category",
                      "expression": "`category`"
                    },
                    {
                      "name": "revenue",
                      "expression": "SUM(`revenue`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "frame": {
                "showTitle": true,
                "title": "Revenue by category"
              },
              "encodings": {
                "x": {
                  "fieldName": "category",
                  "scale": {
                    "type": "categorical"
                  }
                },
                "y": {
                  "fieldName": "revenue",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "Revenue (USD)"
                }
              }
            }
          },
          "position": {
            "x": 0,
            "y": 12,
            "width": 6,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "region",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "regions",
                  "fields": [
                    {
                      "name": "region",
                      "expression": "`region`"
                    },
                    {
                      "name": "revenue",
                      "expression": "SUM(`revenue`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "frame": {
                "showTitle": true,
                "title": "Revenue by region"
              },
              "encodings": {
                "x": {
                  "fieldName": "region",
                  "scale": {
                    "type": "categorical"
                  }
                },
                "y": {
                  "fieldName": "revenue",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "Revenue (USD)"
                }
              }
            }
          },
          "position": {
            "x": 6,
            "y": 12,
            "width": 6,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "top_products",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "products",
                  "fields": [
                    {
                      "name": "product_id",
                      "expression": "`product_id`"
                    },
                    {
                      "name": "product_name",
                      "expression": "`product_name`"
                    },
                    {
                      "name": "category",
                      "expression": "`category`"
                    },
                    {
                      "name": "revenue",
                      "expression": "`revenue`"
                    },
                    {
                      "name": "units",
                      "expression": "`units`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  {
                    "fieldName": "product_id",
                    "displayName": "Product Id"
                  },
                  {
                    "fieldName": "product_name",
                    "displayName": "Product Name"
                  },
                  {
                    "fieldName": "category",
                    "displayName": "Category"
                  },
                  {
                    "fieldName": "revenue",
                    "displayName": "Revenue"
                  },
                  {
                    "fieldName": "units",
                    "displayName": "Units"
                  }
                ]
              },
              "frame": {
                "showTitle": true,
                "title": "Top products \u2014 all time"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 18,
            "width": 12,
            "height": 6
          }
        }
      ]
    }
  ]
}
